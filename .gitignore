# Detector test output — regenerated by tools/*.py, never worth committing.
tools/detect_out/
tools/method_out/
tools/ring_out/
tools/arcade_out/
tools/dual_out/
tools/struct_out/
tools/*_montage.jpg
tools/*.jpg
tools/__pycache__/

# Training data and runs. This is the user's own footage and what is derived
# from it: it must never enter the repository, private or not.
fisheye_dataset/
**/fisheye_dataset/
dataset/
runs/
*.pt
*.cache

# Models are fine (weights only, no footage) — but keep the repository private.
!models/*.onnx
!models/*.mlmodel

# The CoreML package is generated from the ONNX during the Codemagic build:
# coremltools is macOS-only, so it cannot exist in a Windows checkout.
SteadyFisheye/*.mlpackage/
SteadyFisheye/*.mlmodelc/

# Local scratch
icon-sizes.png
*.ips
.DS_Store
