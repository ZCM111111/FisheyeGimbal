# Detector test output — regenerated by tools/*.py, never worth committing.
tools/detect_out/
tools/method_out/
tools/ring_out/
tools/arcade_out/
tools/dual_out/
tools/struct_out/
tools/*_montage.jpg
tools/*.jpg
tools/__pycache__/

# Training data and runs. This is the user's own footage and what is derived
# from it: it must never enter the repository, private or not.
fisheye_dataset/
**/fisheye_dataset/
dataset/
runs/
*.pt
*.cache

# Models are fine (weights only, no footage) — but keep the repository private.
# Both forms are kept deliberately: the .pt is what the Codemagic build turns
# into CoreML, and the .onnx is what tools/check_onnx.py and friends measure.
!models/*.pt
!models/*.onnx
!models/*.mlmodel

# The CoreML model is generated from the .pt during the Codemagic build.
# coremltools has no ONNX frontend and only runs on macOS, so neither the
# package nor the compiled model can exist in a Windows checkout.
SteadyFisheye/*.mlpackage/
SteadyFisheye/*.mlmodelc/
models/*.mlpackage/
models/_compiled/

# Local scratch
icon-sizes.png
*.ips
.DS_Store
